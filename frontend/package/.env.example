# Public API URL for client-side queries (in production, usually /api via reverse proxy or direct domain)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Server-side Next.js route handlers backend target
DJANGO_API_URL=http://127.0.0.1:8000/api

# NextAuth Canonical Application URL
NEXTAUTH_URL=http://localhost:3000

# NextAuth Secret Token (generate with `openssl rand -base64 32`)
NEXTAUTH_SECRET=ffc7161deb1d093c465d4eef25722da8ae4f474b45f4b2f5bf15c023d5ff233c

# Optional external/remote Loan Core Engine microservice
NEXT_PUBLIC_LOAN_API_URL=https://v1.royalltd.co.ke/lne/api
